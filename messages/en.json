    "start": "Let's start!",
    "page": "Page",
    "pages": {
      "1": {
        "title": "Nutti Squirrel and the Secret of Nuts",
        "text": "Once upon a time, there was a lively squirrel named Nutti who lived in a big oak tree. Nutti was different from other squirrels - he loved mathematics!"
      },
      "2": {
        "title": "Preparing for Winter",
        "text": "Autumn was coming, and Nutti knew he had to collect nuts for the winter. But how many nuts would he actually need?"
      },
      "3": {
        "title": "The Power of Math",
        "text": "Nutti remembered that his grandmother had taught him math operations. 'When you learn addition, subtraction, multiplication, and division, you can calculate how many acorns you need!' grandma had said."
      },
      "4": {
        "title": "Adventure Begins",
        "text": "Nutti decided he would learn all math operations perfectly. With addition and subtraction he could count his collected acorns, with multiplication how many he'd have over several days, and with division how to share them evenly!"
      },
      "5": {
        "title": "Join Nutti's Adventure!",
        "text": "Now you can help Nutti learn math! Every correct answer in addition, subtraction, multiplication, or division helps Nutti collect acorns for winter. Are you ready?"
      }
    },
    "funFacts": {
      "page3": "Did you know? With math you can calculate everything: 7 + 8 = 15, 15 - 7 = 8, 7 × 8 = 56, 56 ÷ 7 = 8!",
      "page5": "Hint: Use the keyboard: 0-9, Enter, Backspace, and H (hint)!"
    }
